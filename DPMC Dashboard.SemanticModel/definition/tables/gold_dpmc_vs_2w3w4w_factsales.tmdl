	column BranchMonthKey = ```
			
			VAR EOM = EOMONTH ( gold_dpmc_vs_2w3w4w_factsales[InvoiceDate], 0 )
			VAR YM = YEAR ( EOM ) * 100 + MONTH ( EOM )
			RETURN
			    YM & "|" & TRIM ( RELATED ( gold_dpmc_vs_2w3w4w_dimpremises[PremiseCode] ) )
			
			```
		lineageTag: 34fb20c7-99e1-444b-9dfa-debdc1b9149d
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

