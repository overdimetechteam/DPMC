table gold_dpmc_vs_2w3w4w_factsales
	lineageTag: 334905bf-f128-4a7c-b31b-a873db67a5c1

	measure 'Selected Vehicle Type' = SELECTEDVALUE ( 'VehicleTypeSelector'[Vehicle Type], "2W" )
		lineageTag: 34be1d40-f9b6-49ff-98f3-b42e10dd49d7

		changedProperty = IsHidden

	measure 'Cash Sales' = CALCULATE(COUNTROWS(gold_dpmc_vs_2w3w4w_factsales), gold_dpmc_vs_2w3w4w_factsales[PaymentType] = "CASH")
		formatString: 0
		lineageTag: 9aae2f1d-19d9-4dff-a03b-419cca2cc659

	measure 'Finance Sales' = CALCULATE(COUNTROWS(gold_dpmc_vs_2w3w4w_factsales), gold_dpmc_vs_2w3w4w_factsales[PaymentType] = "FINANCE")
		formatString: 0
		lineageTag: 5571996e-0633-40c4-beac-10f14a3bffc7

	measure 'Total Units Sold' = COUNTROWS(gold_dpmc_vs_2w3w4w_factsales)
		formatString: 0
		lineageTag: 7ffec42b-b12f-48cf-80e6-8b967234eada

	measure 'Dealer Count' =
			
			CALCULATE(
			    DISTINCTCOUNT(gold_dpmc_vs_2w3w4w_factinquiry[DealerPremiseDesc]),
			    TREATAS(
			        VALUES(gold_dpmc_vs_2w3w4w_factsales[InquiryNo]),
			        gold_dpmc_vs_2w3w4w_factinquiry[InquiryNo]
			    )
			)
		formatString: 0
		lineageTag: c14758a5-5d38-45dc-b19c-78ce47c061aa

	measure 'Premise Count' = DISTINCTCOUNT(gold_dpmc_vs_2w3w4w_factsales[PremiseSK])
		formatString: 0
		lineageTag: e5544d01-b106-4777-929f-1fea0e2de86c

