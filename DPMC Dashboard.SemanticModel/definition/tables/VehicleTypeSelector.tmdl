table VehicleTypeSelector
	lineageTag: 5979d831-7f36-439f-afef-908a46a3df45

	measure 'Total Working Days' = ```
			
			VAR AsOfDate = [Selected As Of Date]
			VAR MonthStart = DATE ( YEAR ( AsOfDate ), MONTH ( AsOfDate ), 1 )
			VAR MonthEnd = 
			    CALCULATE (
			        MAX ( Vw_dpmc_vs_DimDate[TheDate] ),
			        ALL ( Vw_dpmc_vs_DimDate ),
			        Vw_dpmc_vs_DimDate[TheFirstOfMonth] = MonthStart
			    )
			RETURN
			    CALCULATE (
			        MAX ( Vw_dpmc_vs_DimDate[WorkingDay] ),
			        ALL ( Vw_dpmc_vs_DimDate ),
			        Vw_dpmc_vs_DimDate[TheDate] = MonthEnd
			    )
			```
		lineageTag: 252f7970-c951-4c6d-8760-f65c175b0875

	measure 'Performed Working Days' =
			
			VAR AsOfDate = [Selected As Of Date]
			RETURN
			    CALCULATE (
			        MAX ( Vw_dpmc_vs_DimDate[WorkingDay] ),
			        ALL ( Vw_dpmc_vs_DimDate ),
			        Vw_dpmc_vs_DimDate[TheDate] = AsOfDate
			    )
		formatString: 0
		lineageTag: 2a987fb3-1f86-4a2c-b983-69fbefce4f81

	measure 'Remaining Working Days' =
			
			[Total Working Days] - [Performed Working Days]
		formatString: 0
		lineageTag: aa4430b1-5fa7-4aca-96d7-b2daf7e395e4

	measure 'Actual Units' =
			
			CALCULATE (
			    DISTINCTCOUNT ( gold_dpmc_vs_2w3w4w_factsales[ChassisNo] ),
			    NOT ISBLANK ( gold_dpmc_vs_2w3w4w_factsales[InvoiceNo] )
			)
		formatString: 0
		lineageTag: 1ac71b14-2082-4497-884f-12f30f2705ec

	measure 'Target (Selected)' = VAR VT = [Selected Vehicle Type] RETURN SWITCH(VT, "2W", SUM(BranchMonthTarget[Target2W]), "3W", SUM(BranchMonthTarget[Target3W]), BLANK())
		formatString: 0
		lineageTag: 7d0d0746-93fe-461f-a6cf-9578a3931464

	measure 'Achievement %' = DIVIDE([Actual Units], [Target (Selected)], 0) * 100
		lineageTag: 4c80deb9-ae37-4638-8c29-e9bd5734b035

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Remaining Target' =
			
			[Target (Selected)] - [Actual Units]
		formatString: 0
		lineageTag: 94053066-d7e7-482b-bfa5-c9a1e63ed564

	measure 'Sales Value (LKR M)' =
			
			DIVIDE (
			    CALCULATE (
			        SUM ( gold_dpmc_vs_2w3w4w_factsales[InvoiceValue] ),
			        NOT ISBLANK ( gold_dpmc_vs_2w3w4w_factsales[InvoiceNo] )
			    ),
			    1000000
			)
		lineageTag: afec424c-48fd-4ba2-8462-f29bdbbea0ce

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Stock Units' =
			
			SUM ( gold_dpmc_vs_2w3w4w_factstock[CurrentStock] )
		formatString: 0
		lineageTag: 7ef00687-1f91-461d-b6af-530c81cb997d

	measure 'Total Bookings' =
			
			CALCULATE (
			    DISTINCTCOUNT ( gold_dpmc_vs_2w3w4w_factsales[ChassisNo] ),
			    NOT ISBLANK ( gold_dpmc_vs_2w3w4w_factsales[BookingNo] )
			)
		formatString: 0
		lineageTag: 822e3ac3-5660-4512-aa64-0d61d23b89ae

	measure 'Confirmed Bookings' =
			
			CALCULATE (
			    [Total Bookings],
			    NOT ISBLANK ( gold_dpmc_vs_2w3w4w_factsales[ConfirmDate] )
			)
		formatString: 0
		lineageTag: 4956c4e9-91d0-4669-b0e8-f548f4119f58

	measure 'Pending Bookings' =
			
			[Total Bookings] - [Confirmed Bookings]
		formatString: 0
		lineageTag: d0243492-2c5d-4733-af07-c8768d1512c5

	measure 'No of Inquiries' =
			
			DISTINCTCOUNT ( gold_dpmc_vs_2w3w4w_factinquiry[InquiryNo] )
		formatString: 0
		lineageTag: 4863db7d-3a9d-42ad-bf4a-9117fbcaaeed

	measure GRNs =
			
			DISTINCTCOUNT ( gold_dpmc_vs_2w3w4w_factgrndetails[ChassisNo] )
		formatString: 0
		lineageTag: 6ff482ac-3cbd-47a5-9bde-88956c43c93a

	measure 'Delivery Notes' =
			
			DISTINCTCOUNT ( gold_dpmc_vs_2w3w4w_factdeliverynotes[ChassisNo] )
		formatString: 0
		lineageTag: 04597c4b-31b5-447b-b2e4-50af71847af3

	measure 'KPI Metrices (HTML)' =
			
			VAR SalesValue = [Sales Value (LKR M)]
			VAR StockUnits = [Stock Units]
			VAR Bookings = [Total Bookings]
			VAR Inquiries = [No of Inquiries]
			VAR GRNCount = [GRNs]
			VAR DN = [Delivery Notes]
			VAR ConfirmedB = [Confirmed Bookings]
			VAR PendingB = [Pending Bookings]
			
			VAR Style =
			"<style>
			  .kpi-grid{display:grid; grid-template-columns:repeat(4,1fr); gap:12px; font-family:'Segoe UI',sans-serif;}
			  @media (max-width:520px){ .kpi-grid{grid-template-columns:repeat(2,1fr);} }
			  .kpi{background:#152540; border:1px solid #2A3F63; border-radius:14px; padding:14px 16px;
			    display:flex; flex-direction:column; gap:6px; transition:transform .18s ease, border-color .18s ease;}
			  .kpi:hover{transform:translateY(-2px); border-color:#3A5488;}
			  .kpi .label{font-size:11px; color:#93A5C4; text-transform:uppercase; letter-spacing:.5px; font-weight:600;}
			  .kpi .value{font-family:Consolas,'IBM Plex Mono',monospace; font-weight:700; font-size:24px; color:#EEF3FB;}
			</style>"
			
			VAR Card1 = "<div class='kpi'><div class='label'>Sales Value</div><div class='value'>" & FORMAT ( SalesValue, "#,##0.0" ) & "M</div></div>"
			VAR Card2 = "<div class='kpi'><div class='label'>Stock Units</div><div class='value'>" & FORMAT ( StockUnits, "#,##0" ) & "</div></div>"
			VAR Card3 = "<div class='kpi'><div class='label'>Bookings</div><div class='value'>" & FORMAT ( Bookings, "#,##0" ) & "</div></div>"
			VAR Card4 = "<div class='kpi'><div class='label'>Inquiries</div><div class='value'>" & FORMAT ( Inquiries, "#,##0" ) & "</div></div>"
			VAR Card5 = "<div class='kpi'><div class='label'>GRNs</div><div class='value'>" & FORMAT ( GRNCount, "#,##0" ) & "</div></div>"
			VAR Card6 = "<div class='kpi'><div class='label'>Delivery Notes</div><div class='value'>" & FORMAT ( DN, "#,##0" ) & "</div></div>"
			VAR Card7 = "<div class='kpi'><div class='label'>Confirmed Bookings</div><div class='value'>" & FORMAT ( ConfirmedB, "#,##0" ) & "</div></div>"
			VAR Card8 = "<div class='kpi'><div class='label'>Pending Bookings</div><div class='value'>" & FORMAT ( PendingB, "#,##0" ) & "</div></div>"
			
			RETURN
			Style & "<div class='kpi-grid'>" & Card1 & Card2 & Card3 & Card4 & Card5 & Card6 & Card7 & Card8 & "</div>"
		lineageTag: d6a49a0a-53c2-48d4-aabc-6a37ec5ce7df

	measure 'Next Daily Target' = ```
			
			VAR TargetUnits = 
			    SUM(gold_dpmc_vs_2w3w_target[2WTarget]) + SUM(gold_dpmc_vs_2w3w_target[3WTarget])
			VAR ActualUnits = 
			    CALCULATE(COUNTROWS(gold_dpmc_vs_2w3w4w_factsales))
			VAR RemainingDays = 
			    [Remaining Working Days]
			RETURN
			DIVIDE(TargetUnits - ActualUnits, RemainingDays)
			```
		lineageTag: 17022eed-0c87-467d-b840-fabbea6ff05c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Achievement = DIVIDE([Actual Units], [Target (Selected)])
		lineageTag: b6ab4a27-3e54-4f15-aa20-a4b6a819c378

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'DPMC Total Units (3W)' =
			
			CALCULATE(
			    [Actual Units],
			    gold_dpmc_vs_2w3w4w_dimproduct[VehicleTypeShort] = "3W"
			)
		formatString: 0
		lineageTag: 9d62ef11-6fbb-4869-947f-0f13eab28ba8

	measure 'Competitor Total Units' =
			
			CALCULATE(
			    SUM(gold_dpmc_vs_2w3w4w_competitorwisereg[Units]),
			    gold_dpmc_vs_2w3w4w_competitorwisereg[productline] = "3W"
			)
		formatString: 0
		lineageTag: f2d21848-4f5f-47fc-974a-bb2b60db8e0b

	measure 'Gauge HTML' =
			
			VAR PctVal = [Achievement %]
			VAR ScaleMax = 120
			VAR ClampedPct = MIN ( MAX ( PctVal, 0 ), ScaleMax )
			VAR NeedleDeg = ( ClampedPct / ScaleMax ) * 180 - 90
			VAR ActualTxt = FORMAT ( [Actual Units], "#,##0" )
			VAR TargetTxt = FORMAT ( [Target (Selected)], "#,##0" )
			VAR RemainingTxt = FORMAT ( [Remaining Target], "#,##0" )
			VAR PctTxt = FORMAT ( PctVal, "0.0" ) & "%"
			VAR NeedleDegTxt = FORMAT ( NeedleDeg, "0.0" )
			RETURN
			"<div style=""max-width:320px;margin:0 auto;text-align:center;font-family:Segoe UI, sans-serif;"">" &
			"<div style=""position:relative;width:300px;height:150px;margin:0 auto;"">" &
			"<div style=""position:absolute;width:300px;height:300px;border-radius:50%;background:conic-gradient(from 270deg, #d03b3b 0deg 72deg, #fab219 72deg 135deg, #0ca30c 135deg 180deg, transparent 180deg 360deg);""></div>" &
			"<div style=""position:absolute;width:180px;height:180px;left:60px;top:60px;border-radius:50%;background:#ffffff;""></div>" &
			"<div style=""position:absolute;left:150px;bottom:0;width:3px;height:110px;background:#1a1a1a;transform-origin:bottom center;transform:rotate(" & NeedleDegTxt & "deg);border-radius:2px;""></div>" &
			"<div style=""position:absolute;left:144px;bottom:-6px;width:12px;height:12px;border-radius:50%;background:#1a1a1a;""></div>" &
			"</div>" &
			"<div style=""font-size:32px;font-weight:600;color:#1a1a1a;margin-top:8px;"">" & PctTxt & "</div>" &
			"<div style=""font-size:13px;color:#5f5f5f;"">of monthly target</div>" &
			"<div style=""display:flex;justify-content:center;gap:16px;margin-top:12px;font-size:13px;"">" &
			"<span style=""color:#5f5f5f;"">Actual <b style=""color:#1a1a1a;"">" & ActualTxt & "</b></span>" &
			"<span style=""color:#5f5f5f;"">Target <b style=""color:#1a1a1a;"">" & TargetTxt & "</b></span>" &
			"</div>" &
			"<div style=""background:#f1f1ee;border-radius:6px;padding:8px 12px;margin-top:10px;display:inline-block;"">" &
			"<span style=""font-size:13px;color:#5f5f5f;"">Remaining target </span>" &
			"<span style=""font-size:14px;font-weight:600;color:#1a1a1a;"">" & RemainingTxt & "</span>" &
			"</div>" &
			"</div>"
		lineageTag: 98965685-cba9-463e-86dc-6208e7fb5a8a

	measure 'GRN Count' =
			
			DISTINCTCOUNT ( gold_dpmc_vs_2w3w4w_factgrndetails[ChassisNo] )
		formatString: 0
		lineageTag: e0e0b1b3-7c43-4289-900a-61795aa158fc

	column 'Vehicle Type'
		lineageTag: 35e92f18-5e72-4d7c-b541-10f7aed243fd
		summarizeBy: none
		isNameInferred
		sourceColumn: [Vehicle Type]

		annotation SummarizationSetBy = Automatic

	partition VehicleTypeSelector = calculated
		mode: import
		source = DATATABLE("Vehicle Type", STRING, {{"2W"}, {"3W"}})

	annotation PBI_Id = d6c9398321de4168bfa88fd977938be9

